{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.js" },
    { "src": "/health", "dest": "api/index.js" },
    { "src": "/super", "dest": "public/super/index.html" },
    { "src": "/admin", "dest": "public/admin/index.html" },
    { "src": "/ref(.*)", "dest": "public/ref/index.html" },
    { "src": "/(.*)", "dest": "public/$1" }
  ]
}
