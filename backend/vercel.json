{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["public/**"]
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "index.js" },
    { "src": "/health", "dest": "index.js" },
    { "src": "/super(.*)", "dest": "index.js" },
    { "src": "/admin(.*)", "dest": "index.js" },
    { "src": "/ref(.*)", "dest": "index.js" },
    { "src": "/(.*)", "dest": "index.js" }
  ]
}
